# Banco: Postgres compartilhado do DB-DOCKER (db-postgres), database "kb"
DATABASE_URL=postgresql://user:change-me@localhost:5432/kb
# Só para o docker-compose.yml (monta o DATABASE_URL do container com host db-postgres)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me

# URL pública do servidor (usada no comando de conexão devolvido pelo create_agent)
PUBLIC_URL=http://localhost:8000

# Migrações: vão embutidas no pacote (src/mcp_rag_api/migrations). Só defina MIGRATIONS_DIR
# para apontar para um diretório alternativo (compatibilidade com deploys antigos).
# MIGRATIONS_DIR=/caminho/para/migrations

# Embeddings: voyage | openai | huggingface | local | fake
#   voyage      -> precisa VOYAGE_API_KEY (modelo padrão voyage-3.5, 1024 dims)
#   openai      -> precisa OPENAI_API_KEY (text-embedding-3-small reduzido para 1024 dims)
#   huggingface -> precisa HF_API_KEY (Inference API; padrão BAAI/bge-m3, 1024 dims, bom em PT-BR)
#   local  -> instala extra "local" (sentence-transformers, BAAI/bge-m3, 1024 dims, roda na máquina)
#   fake   -> só para testes/dev: vetores determinísticos SEM semântica
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=
HF_API_KEY=
# huggingface: endpoint feature-extraction (vazio = derivado do EMBEDDING_MODEL)
EMBEDDING_API_URL=
# textos por requisição ao provedor (0 = padrão do provedor)
EMBEDDING_BATCH_SIZE=0
# Trocou de provedor/modelo? Rode `mcp-rag-api reindex` (vetores de modelos diferentes não se comparam).
# A dimensão do vetor é FIXA em 1024 (migrations/001_init.sql): não há configuração para isso.

# Diretório com as migrações SQL aplicadas no start (padrão: ./migrations)
#MIGRATIONS_DIR=migrations

# Chunking (em palavras)
CHUNK_WORDS=450
CHUNK_OVERLAP_WORDS=60

# Detecção de duplicatas (similaridade de cosseno 0..1)
DUPLICATE_THRESHOLD=0.92
MEMORY_DUPLICATE_THRESHOLD=0.90

# load_agent: quantas memórias entram no contexto inicial
LOAD_AGENT_MEMORY_LIMIT=15

# Modo stdio: chave usada pelo processo local (ou desligue a auth só em dev)
KB_API_KEY=
KB_AUTH_DISABLED=false

# Dashboard: falhas de login permitidas por (usuário, IP) antes do backoff exponencial
# (2s, dobrando a cada tentativa até 15 min de bloqueio). 0 desliga o rate limit (só dev).
DASH_LOGIN_RATE_LIMIT=5

# 2FA da dashboard (opcional): cifra no banco os segredos TOTP dos apps autenticadores (AES-256-GCM).
# Vazio = texto puro. Gere com `openssl rand -base64 32` (mín. 32 caracteres) e guarde fora do banco:
# sem ela, ninguém com 2FA consegue entrar até um admin resetar. Depois de definir, cifre os segredos
# já gravados com `mcp-rag-api encrypt-2fa-secrets` (`--decrypt` volta para texto puro, p/ trocar a chave).
DASH_TOTP_ENCRYPTION_KEY=

# Logging do servidor: DEBUG | INFO | WARNING | ERROR | CRITICAL (padrão INFO)
KB_LOG_LEVEL=INFO

# Sessão da dashboard: tempo de vida em horas (padrão 168 = 7 dias)
DASH_SESSION_TTL_HOURS=168

# OAuth do MCP: clientes como o Claude (claude.ai, Desktop, Code) conectam em PUBLIC_URL/mcp pela tela
# "Autorizar" (login da dashboard), sem copiar chave. O issuer é o PUBLIC_URL: precisa ser https
# (http só em localhost) — senão o OAuth fica desligado e só as chaves kb_sk_ valem.
OAUTH_ENABLED=true
# validade do access token (minutos) e do refresh token rotativo (dias)
OAUTH_ACCESS_TTL_MINUTES=60
OAUTH_REFRESH_TTL_DAYS=30
# Clientes MCP que podem se registrar (DCR): o redirect_uri precisa ser https num destes hosts (subdomínios
# inclusos), um esquema de app nativo da lista abaixo ou loopback http (localhost/127.0.0.1, sempre aceito).
# Cliente novo recusado? O log mostra "oauth: registro recusado (redirect fora da allowlist): [...]" — some o
# host (ou esquema) aqui. Definir a variável SUBSTITUI a lista padrão: repita os que quiser manter.
OAUTH_REDIRECT_ALLOWLIST=claude.ai,claude.com,chatgpt.com,openai.com,vscode.dev,mistral.ai
OAUTH_REDIRECT_SCHEMES=cursor,vscode,vscode-insiders
